NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public host served by this application. Every other host is redirected here.
CANONICAL_HOST=google.studentembassador.com

# Internal backend address used by the same-origin /api proxy.
API_ORIGIN=http://127.0.0.1:3001

# Used only to enrich sitemap.xml. Keep it internal in production.
SEO_API_URL=http://127.0.0.1:3001/api/2026/google/seo/index
