NODE_ENV=development
HOST=0.0.0.0
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=studentsEmbassador
PUBLIC_APP_URL=http://localhost:3000

# Mailgun transactional e-mail. Keep the actual key only in a local .env or
# in your deployment secret manager; never commit it.
MAILGUN_DOMAIN=studentembassador.com
MAILGUN_API_KEY=your-mailgun-api-key
# Use https://api.eu.mailgun.net only when the Mailgun domain is hosted in EU.
MAILGUN_API_BASE_URL=https://api.mailgun.net

# Comma-separated list when more than one trusted frontend is needed.
FRONTEND_ORIGIN=http://localhost:3000

# Browser key: restrict it by HTTP referrer in Google Cloud. Enable Maps
# JavaScript API and Geocoding API for the national community map.
GOOGLE_MAPS_BROWSER_API_KEY=
# Optional Cloud-based Maps Styling map ID.
GOOGLE_MAPS_MAP_ID=

# OAuth 2.0 Web Client ID used by Google Identity Services. Configure
# http://localhost:3000 and https://campus.studentembassador.com as authorized
# JavaScript origins in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
